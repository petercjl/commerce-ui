{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerce-ui.local/contracts/compact-workbench-1.0.schema.json",
  "title": "Compact Commerce Workbench ViewModel",
  "description": "Versioned, Agent-neutral input contract for commerce-ui.",
  "type": "object",
  "required": ["contract", "meta", "views"],
  "properties": {
    "contract": {"const": "compact-workbench@1.0"},
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "footer": {"type": "string"},
        "external_images": {
          "enum": ["forbid", "allow_https"],
          "default": "forbid",
          "description": "Remote product images remain forbidden unless the report owner explicitly approves HTTPS image dependencies."
        },
        "source_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "shell": {
      "type": "object",
      "properties": {
        "brand_mark": {"type": "string"},
        "brand_title": {"type": "string"},
        "brand_subtitle": {"type": "string"},
        "nav_label": {"type": "string"},
        "status": {"type": "array", "items": {"type": "string"}},
        "search": {"type": "boolean"},
        "search_placeholder": {"type": "string"},
        "date_range": {"type": "string"},
        "sidebar_tabs": {
          "type": "boolean",
          "default": false,
          "description": "Move top-level tab indexes into the owning view's sidebar group while preserving tab panels in the content area."
        },
        "reading_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/readingPathItem"}
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "oneOf": [
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/asset"}},
        {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/asset"}, {"required": ["id"]}]}}
      ]
    },
    "views": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/view"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "readingPathItem": {
      "type": "object",
      "required": ["view_id", "label"],
      "properties": {
        "view_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "tab_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "alt": {"type": "string"},
        "role": {"type": "string"},
        "semantic_label": {"type": "string"},
        "subject_id": {"type": "string"},
        "evidence_level": {"enum": ["direct", "derived", "illustrative"]}
      },
      "additionalProperties": true
    },
    "view": {
      "type": "object",
      "required": ["id", "label", "title", "blocks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1},
        "eyebrow": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "badge": {
          "oneOf": [
            {"type": "string"},
            {"type": "object", "properties": {"text": {"type": "string"}, "tone": {"$ref": "#/$defs/tone"}}, "required": ["text"]}
          ]
        },
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      },
      "additionalProperties": false
    },
    "tone": {"enum": ["info", "positive", "warning", "danger"]},
    "conclusionSegment": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "tone": {"$ref": "#/$defs/tone"},
        "emphasis": {"enum": ["normal", "strong", "italic", "strong-italic"]}
      },
      "additionalProperties": false
    },
    "conclusionItem": {
      "type": "object",
      "required": ["label", "segments"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conclusionSegment"}},
        "tone": {"$ref": "#/$defs/tone"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["conclusion", "alert", "metrics", "grid", "card", "list", "callout", "text", "table", "tabs", "products", "stats", "badge", "button", "actions", "empty"]},
        "title": {"type": "string"},
        "meta": {"type": "string"},
        "text": {"type": "string"},
        "tone": {"$ref": "#/$defs/tone"},
        "columns": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 8},
            {"type": "array", "minItems": 1, "items": {"type": "string"}}
          ]
        },
        "variant": {"type": "string"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "items": {"type": "array"},
        "tabs": {"type": "array"},
        "rows": {"type": "array"},
        "paragraphs": {"type": "array", "items": {"type": "string"}},
        "ordered": {"type": "boolean"},
        "label": {"type": "string"},
        "target_view": {"type": "string"},
        "url": {"type": "string"},
        "empty_text": {"type": "string"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 200},
        "sort_options": {"type": "array", "items": {"type": "object", "required": ["key", "label"], "properties": {"key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "label": {"type": "string"}, "direction": {"enum": ["asc", "desc"]}}, "additionalProperties": false}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "conclusion"}}, "required": ["type"]},
          "then": {"required": ["items"], "properties": {"items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/conclusionItem"}}}}
        },
        {
          "if": {"properties": {"type": {"const": "products"}}, "required": ["type"]},
          "then": {"properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/product"}}}}
        }
      ],
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "properties": {
        "asset_id": {"type": "string"},
        "image_url": {"type": "string", "pattern": "^https://[^\\s\\\"'<>]+$"},
        "item_url": {"type": "string", "pattern": "^https://[^\\s\\\"'<>]+$"},
        "alt": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://[^\\s\\\"'<>]+$"},
        "action_label": {"type": "string"},
        "copy_value": {"type": "string"},
        "copy_label": {"type": "string"},
        "sort_values": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}
      },
      "additionalProperties": true
    }
  }
}
