{
  "name": "@petercjl/commerce-ui",
  "version": "1.2.6",
  "type": "module",
  "description": "Portable HTML report Skill, commerce-ui CLI and versioned reusable template packs",
  "bin": {
    "commerce-ui": "bin/commerce-ui.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/commerce-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "bin",
    "src",
    "runtime",
    "skill",
    "requirements.txt",
    "README.md",
    "!runtime/**/__pycache__/**",
    "!runtime/**/*.pyc",
    "!runtime/**/*.bak",
    "!runtime/**/*.html.pre-*",
    "!runtime/tests/*.html",
    "!runtime/tests/test_*.py",
    "!skill/**/.commerce-ui*.json",
    "!skill/**/.install-meta.json"
  ],
  "scripts": {
    "check": "node --check bin/commerce-ui.mjs && node --check src/lifecycle.mjs",
    "test": "node --test test/*.test.mjs && node bin/commerce-ui.mjs test-runtime",
    "prepack": "npm run check"
  }
}
